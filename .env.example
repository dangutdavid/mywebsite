NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3002

# Lead database. Used by /api/contact to store enquiries.
DATABASE_URL=postgres://skydive:skydive_dev_password@127.0.0.1:5434/skydive
DATABASE_SSL=false
DATABASE_POOL_MAX=5
LEADS_ADMIN_TOKEN=replace-with-a-long-random-private-token

# Email notifications. Development mode logs the enquiry server-side.
CONTACT_EMAIL_PROVIDER=development
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_PROVIDER_API_KEY=

# Optional analytics.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
